{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "eCommerce.UsersService",
    "Audience": "eCommerce.Client",
    "AccessTokenMinutes": 15
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresConnection": "Host=$POSTGRES_HOST; Port=5432; Database=eCommerceUsers; Username=postgres; Password=$POSTGRES_PASSWORD"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:9090"
      }
    }
  }
}
