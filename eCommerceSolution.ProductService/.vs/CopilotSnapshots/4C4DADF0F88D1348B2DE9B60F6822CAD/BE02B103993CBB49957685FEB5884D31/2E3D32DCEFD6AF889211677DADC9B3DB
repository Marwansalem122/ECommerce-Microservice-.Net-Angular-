using AutoMapper;
using eCommerce.BusinessLogicLayer.DTO;
using eCommerce.DataAccessLayer.Entities;

namespace eCommerce.BusinessLogicLayer.Mappers
{
    internal class ProductToProductResponseProfile : Profile
    {
        public ProductToProductResponseProfile()
        {
            CreateMap<Product, ProductResponse>()
                .ForCtorParam("Category", opt => opt.MapFrom(src =>
                    Enum.TryParse<CategoryOptions>(src.Category, true, out var category)
                        ? category
                        : default(CategoryOptions)));
        }
    }
}